---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortBooks } from '@/lib/notionBooks';

const books = sortBooks((await getCollection('books')).map((entry) => entry.data));

const reading = books.filter(b => b.status === 'reading');
const read    = books.filter(b => b.status === 'read');
const want    = books.filter(b => b.status === 'want');
---

<BaseLayout
  title="Reading"
  description="Books Isaac Dessert is reading, has read, and wants to read."
>
  <div class="max-w-3xl mx-auto px-6 py-20">
    <header class="mb-14">
      <h1 class="section-heading">Reading</h1>
      <p class="section-subheading">// books that shaped how I think</p>
    </header>

    {books.length === 0 ? (
      <p class="font-mono text-text-muted text-sm">Reading list coming soon.</p>
    ) : (
      <Fragment>
        <!-- Currently Reading -->
        {reading.length > 0 && (
          <section class="mb-14">
            <h2 class="font-mono text-accent-green text-xs uppercase tracking-widest mb-6 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-accent-green animate-pulse inline-block"></span>
              Currently Reading
            </h2>
            <div class="space-y-4">
              {reading.map(book => (
                <div class="border border-accent-green/30 bg-accent-green/5 p-5">
                  <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
                    <h3 class="font-mono font-semibold text-text-primary">
                      {book.url ? (
                        <a href={book.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent-yellow transition-colors">{book.title}</a>
                      ) : (
                        book.title
                      )}
                    </h3>
                  </div>
                  <p class="font-mono text-xs text-text-muted mb-2">{book.author}</p>
                  {book.take && (
                    <p class="text-sm text-text-muted leading-relaxed">{book.take}</p>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Read -->
        {read.length > 0 && (
          <section class="mb-14">
            <h2 class="font-mono text-accent-yellow text-xs uppercase tracking-widest mb-6">
              Read
            </h2>
            <div class="space-y-px">
              {read.map(book => (
                <div class="group border border-transparent hover:border-bg-surface p-4 -mx-4 transition-colors">
                  <div class="flex items-start gap-3">
                    <span class="text-accent-yellow shrink-0 text-xs font-mono leading-5">▸</span>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-start justify-between gap-4">
                        <span class="font-mono text-sm font-semibold text-text-primary leading-5">
                          {book.url ? (
                            <a href={book.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent-yellow transition-colors">{book.title}</a>
                          ) : (
                            book.title
                          )}
                        </span>
                        {book.year && (
                          <span class="font-mono text-xs text-text-muted shrink-0 leading-5">{book.year}</span>
                        )}
                      </div>
                      <p class="font-mono text-xs text-text-muted mt-0.5">{book.author}</p>
                      {book.take && (
                        <p class="text-sm text-text-muted leading-relaxed mt-1.5">{book.take}</p>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Want to Read -->
        {want.length > 0 && (
          <section>
            <h2 class="font-mono text-text-muted text-xs uppercase tracking-widest mb-6">
              Want to Read
            </h2>
            <div class="space-y-px">
              {want.map(book => (
                <div class="flex items-start gap-3 p-4 -mx-4">
                  <span class="font-mono text-xs text-text-muted shrink-0 leading-5">○</span>
                  <p class="min-w-0 font-mono text-sm text-text-muted leading-5">
                    {book.url ? (
                      <a href={book.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent-yellow transition-colors">{book.title}</a>
                    ) : (
                      book.title
                    )}
                    <span class="text-xs text-text-muted/60 ml-2">— {book.author}</span>
                  </p>
                </div>
              ))}
            </div>
          </section>
        )}
      </Fragment>
    )}
  </div>
</BaseLayout>
